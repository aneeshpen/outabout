# Copy to backend/.env and fill in real values. Never commit the real .env.

# --- Database --------------------------------------------------------------
# Production (the PostgreSQL database the Prisma schema was pushed to):
# DATABASE_URL="postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE"
# Local development / demo default:
DATABASE_URL="sqlite:///./digipass.db"

# Emits CREATE TABLE IF NOT EXISTS on start-up. Never drops or alters.
CREATE_TABLES_ON_STARTUP=true

# --- Security --------------------------------------------------------------
# At least 32 random characters. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it only invalidates tokens already issued, and those expire in
# ACCESS_TOKEN_EXPIRE_MINUTES anyway, so users simply sign in again.
SECRET_KEY="replace-with-a-long-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=20

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. The Vite dev server runs
# over HTTPS, so include the https:// form.
CORS_ORIGINS="http://localhost:5173,https://localhost:5173"

# --- Admin provisioning ----------------------------------------------------
# Password assigned to users created through the admin console / CSV import.
DEFAULT_PASSWORD="replace-with-a-default-password"

# --- Student photo storage (optional) --------------------------------------
# When these are set, photos go to the Supabase bucket and the guard screen
# receives a short-lived signed URL. When they are empty, photos are written to
# backend/uploads and served from /uploads.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="student-photos"
SIGNED_URL_TTL_SECONDS=60
